{
  "name": "nexusflow-task-center",
  "version": "1.0.0",
  "private": true,
  "author": "Antigravity Token Telemetry",
  "main": "dist-electron/main.cjs",
  "description": "Antigravity Token Telemetry — Local desktop telemetry app for Antigravity IDE token usage & cost",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "icons:generate": "node scripts/generate-icons.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "node scripts/build-desktop.mjs && electron .",
    "dist:dir": "node scripts/build-desktop.mjs && electron-builder --dir",
    "dist:mac": "node scripts/build-desktop.mjs && electron-builder --mac",
    "dist:win": "node scripts/build-desktop.mjs && electron-builder --win"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "framer-motion": "^14.13.0",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "electron": "45.5.0",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3"
  }
}
